{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Ventairy/ship-my-flutter/main/schemas/config.schema.json",
  "title": "ship-my-flutter configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "targetBranch",
    "releaseBranchPrefix",
    "hooks",
    "platforms"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Configuration contract version."
    },
    "targetBranch": {
      "type": "string",
      "minLength": 1,
      "default": "main",
      "description": "Branch whose commits feed release pull requests."
    },
    "releaseBranchPrefix": {
      "type": "string",
      "minLength": 1,
      "default": "ship-my-flutter",
      "description": "Prefix for generated platform release branches."
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beforeReleasePr": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative executable run after the next version and changelog are prepared."
        }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ios"],
      "properties": {
        "ios": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "projectPath",
            "buildArgs",
            "testflight",
            "appStore"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Enable iOS release planning and delivery."
            },
            "projectPath": {
              "type": "string",
              "minLength": 1,
              "default": ".",
              "description": "Flutter project root relative to the repository."
            },
            "bundleId": {
              "type": "string",
              "minLength": 1,
              "description": "App Store bundle identifier. Explicit configuration is recommended."
            },
            "scheme": {
              "type": "string",
              "minLength": 1,
              "default": "Runner",
              "description": "Xcode scheme or Flutter flavor to build."
            },
            "buildArgs": {
              "type": "array",
              "description": "Additional arguments appended to flutter build ipa.",
              "items": {
                "type": "string",
                "not": {
                  "pattern": "^--(build-name|build-number|export-options-plist|release|debug|profile|flavor|pub|no-pub)(=|$)"
                }
              }
            },
            "testflight": {
              "type": "object",
              "additionalProperties": false,
              "required": ["groups", "waitTimeoutMinutes"],
              "properties": {
                "groups": {
                  "type": "array",
                  "description": "Exact existing TestFlight group names that should receive the build.",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "waitTimeoutMinutes": {
                  "type": "integer",
                  "minimum": 5,
                  "maximum": 180,
                  "default": 45,
                  "description": "Maximum time to wait for Apple build processing."
                }
              }
            },
            "appStore": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "releaseType"],
              "properties": {
                "mode": {
                  "enum": ["submit-for-review", "upload-only"],
                  "default": "upload-only",
                  "description": "Whether merging uploads only or also submits the tested build for App Review."
                },
                "releaseType": {
                  "enum": ["manual", "automatic", "scheduled"],
                  "default": "manual",
                  "description": "Release behavior after Apple approves the submission."
                },
                "earliestReleaseDate": {
                  "type": "string",
                  "format": "date-time",
                  "description": "ISO 8601 release time required when releaseType is scheduled."
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "releaseType": {
                        "const": "scheduled"
                      }
                    },
                    "required": ["releaseType"]
                  },
                  "then": {
                    "required": ["earliestReleaseDate"]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "releaseType": {
                        "not": {
                          "const": "scheduled"
                        }
                      }
                    },
                    "required": ["releaseType"]
                  },
                  "then": {
                    "not": {
                      "required": ["earliestReleaseDate"]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
